{
  "ConnectionStrings": {
    "Ccs": "Server=SQLSERVER01;Database=CCS;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Application Name=ccs-api"
  },
  "Jwt": {
    "Issuer": "ccs-api",
    "Audience": "ccs-web",
    "SigningKey": "",
    "AccessMinutes": 15,
    "RefreshDays": 14
  },
  "App": { "PublicUrl": "https://ccs.example.com" },
  "FileStore": {
    "Root": "D:\\CcsData\\attachments",
    "DefenderPath": "C:\\Program Files\\Windows Defender\\MpCmdRun.exe"
  },
  "DataProtection": { "KeysFolder": "D:\\CcsData\\keys" },
  "Jobs": { "Enabled": true },
  "Cors": { "WebOrigin": "" },
  "Swagger": { "Enabled": false },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Hangfire": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\CcsData\\logs\\api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 60 } }
    ]
  },
  "AllowedHosts": "*"
}
