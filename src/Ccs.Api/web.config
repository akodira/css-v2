<?xml version="1.0" encoding="utf-8"?>
<!-- IIS site for the API (ASP.NET Core Hosting Bundle, in-process, own application pool "No Managed Code"). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Ccs.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Secrets: set on the application pool or machine, never here:
               ConnectionStrings__Ccs, Jwt__SigningKey -->
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 5 files x 10 MB plus form overhead -->
          <requestLimits maxAllowedContentLength="57671680" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders><remove name="X-Powered-By" /></customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
